# Leave DATABASE_URL empty to use the embedded local database (PGlite in ./.data/pglite).
# In production point it at Postgres (Supabase / Neon), e.g. postgres://user:pass@host:5432/db
DATABASE_URL=

# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First admin, created by `npm run db:seed` only if no admin exists. Must change PIN at first sign-in.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PIN=

# Demo users created by `npm run setup` (db:seed --demo). Test values, local only:
#   Demo Admin  / 111111
#   Demo Leader / 2222
#   Demo Member / 3333
